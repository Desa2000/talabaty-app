# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE — Copy this file to local.properties and fill in real values.
# The file local.properties is blocked by .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Android SDK path (update to match your machine)
sdk.dir=C\:\\Users\\HP\\AppData\\Local\\Android\\sdk

# Flutter SDK path
# flutter.sdk=D\:\\Programs\\flutter

# ── Google Maps Android API Key ───────────────────────────────────────────────
# Obtain from: https://console.cloud.google.com → APIs & Services → Credentials
# Restrict this key to:
#   • Application: Android apps
#   • Package name: com.talabaty.talabaty_app
#   • SHA-1 certificate fingerprint (run: keytool -list -v -keystore ~/.android/debug.keystore)
# Enable APIs: Maps SDK for Android
#
# The Secrets Gradle Plugin reads this key and injects it into AndroidManifest.xml
# as the manifest placeholder ${MAPS_API_KEY}. It is NEVER compiled into source code.
MAPS_API_KEY=YOUR_ANDROID_MAPS_API_KEY_HERE
